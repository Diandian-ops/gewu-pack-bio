{
  "schemaVersion": 1,
  "runtime": {
    "language": "r",
    "version": ">=4.4.0",
    "builtAgainst": "4.5",
    "platforms": ["macos-arm64"]
  },
  "capabilities": ["r-spatial"],
  "requiresBundle": "r-spatial",
  "requiresBundleVersion": "1.0.0",
  "packages": {
    "r": {
      "Seurat": ">=5.0.0",
      "CellChat": ">=1.6.0",
      "ggplot2": ">=4.0.0",
      "ggalluvial": ">=0.12.3",
      "ComplexHeatmap": ">=2.16.0",
      "circlize": ">=0.4.15",
      "igraph": ">=2.0.0",
      "NMF": ">=0.27",
      "BiocManager": ">=1.30.0",
      "jsonlite": ">=1.8.0",
      "base64enc": ">=0.1-3",
      "png": ">=0.1-8"
    }
  },
  "policy": {
    "installInScript": false,
    "networkDuringAnalysis": false,
    "recordPackageVersions": true,
    "recordRuntimeVersion": true,
    "cellchatDbPrefetch": true,
    "comment": "CellChat 本体不在 biof3-r-runtime 显式清单（r-runtime-packages.txt 26 包）；通过 install.json 的 BiocManager::install('CellChat') 一次性补齐；运行时不访问外部网络（CellChatDB.human/mouse 已随 CellChat 包内置）。"
  }
}