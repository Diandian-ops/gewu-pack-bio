{
  "schemaVersion": 1,
  "pluginId": "go-kegg",
  "pluginVersion": "1.0.0",
  "platforms": ["macos-arm64"],
  "fixtures": [
    {
      "id": "valid",
      "description": "Gene list with known GO-enriched genes (human symbols)",
      "inputs": {
        "deg_table": "demo-data/genes.csv",
        "species": "human",
        "gene_id_type": "SYMBOL",
        "padj_cutoff": 0.05,
        "analysis_type": "all"
      },
      "expectedStatus": "valid",
      "expectedOutputs": ["go_bp_results.csv", "kegg_results.csv", "report.html"],
      "requiresBundle": true
    },
    {
      "id": "empty-result",
      "description": "Gene list with no enriched pathways — valid empty result",
      "inputs": {
        "deg_table": "demo-data/genes.csv",
        "species": "human",
        "gene_id_type": "SYMBOL",
        "padj_cutoff": 0.0001,
        "analysis_type": "all"
      },
      "expectedStatus": "valid",
      "expectedNote": "No enriched pathways — valid empty scientific result"
    },
    {
      "id": "missing-inputs",
      "description": "No gene list provided",
      "inputs": {},
      "expectedStatus": "blocked",
      "expectedFailureMode": "missing_required_file_inputs"
    },
    {
      "id": "runtime-not-ready",
      "description": "clusterProfiler or org.Hs.eg.db not installed",
      "inputs": {
        "deg_table": "demo-data/genes.csv",
        "species": "human"
      },
      "expectedStatus": "blocked",
      "expectedFailureMode": "runtime_not_ready",
      "skipOnSupportedPlatform": true
    }
  ],
  "reproducibility": {
    "requireScriptSha256": true,
    "requireParamsHash": true,
    "requireInputSha256": true,
    "requireOutputSha256": true,
    "requireRVersion": true,
    "requirePackageVersions": true,
    "evidenceSource": "runtime-generated artifact-manifest.json + provenance.json"
  }
