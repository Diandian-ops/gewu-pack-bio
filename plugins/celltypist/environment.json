{
  "schemaVersion": 1,
  "runtime": {
    "language": "python",
    "version": ">=3.10.0",
    "builtAgainst": "3.11.9",
    "platforms": ["macos-arm64", "windows-x64"]
  },
  "capabilities": ["py-single-cell"],
  "packages": {
    "python": {
      "scanpy": ">=1.9",
      "anndata": ">=0.9",
      "numpy": ">=1.24",
      "pandas": ">=2.0",
      "scipy": ">=1.10",
      "matplotlib": ">=3.7",
      "seaborn": ">=0.12",
      "Pillow": ">=9.0",
      "celltypist": ">=1.6"
    }
  },
  "policy": {
    "installInScript": false,
    "networkDuringAnalysis": false,
    "recordPackageVersions": true,
    "recordRuntimeVersion": true,
    "requiresBootstrap": ["celltypist"],
    "notes": "celltypist 本体（PyPI ~10MB）不在 biof3-py-runtime 基础栈中（biof3-py-runtime 只含 scanpy/anndata/numpy/pandas/scipy/matplotlib/seaborn 等通用科学栈）。本插件声明 requiresBootstrap，install.json 触发 install manager 在用户首次启动时通过 pip install celltypist>=1.6 局部补装（不动 biof3-py-runtime 主体）。"
  }
}
