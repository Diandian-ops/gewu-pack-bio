{
 "id": "volcano-plot",
 "title": "火山图绘制",
 "subtitle": "差异基因可视化",
 "category": "bulk RNA-seq",
 "language": "r",
 "description": "从差异分析结果绘制火山图",
 "inputs": [
  {
   "id": "deg_table",
   "label": "差异分析结果表 (CSV: gene, log2FoldChange|log2FC, pvalue[, padj])",
   "type": "file",
   "required": true,
   "accept": ".csv"
  },
  {
   "id": "lfc_col",
   "label": "LFC 列名",
   "type": "text",
   "required": false,
   "hint": "log2FoldChange 列名。默认自动探测：优先 log2FoldChange（canonical），fallback log2FC（DESeq2 直接输出）",
   "default": null
  },
  {
   "id": "gene_col",
   "label": "gene ID 列名",
   "type": "text",
   "required": false,
   "default": "gene"
  },
  {
   "id": "pval_col",
   "label": "显著性列名（默认 padj）",
   "type": "text",
   "required": false,
   "default": "padj"
  },
  {
   "id": "fc_threshold",
   "label": "|log2FC| 阈值",
   "type": "number",
   "default": 1,
   "hint": "差异基因判定阈值，默认 1（即 2 倍变化）"
  },
  {
   "id": "pval_threshold",
   "label": "p value 阈值 (-log10)",
   "type": "number",
   "default": 1.3,
   "hint": "默认 1.3 即 p < 0.05"
  },
  {
   "id": "top_n",
   "label": "标注 top N 基因",
   "type": "number",
   "default": 10,
   "hint": "在图上标注变化最显著的 N 个基因名"
  },
  {
   "id": "label_genes",
   "label": "额外标注的基因",
   "type": "text",
   "required": false,
   "default": "",
   "hint": "以逗号分隔的稳定 gene ID；仅增加标签，不改变统计或分类"
  },
  {
   "id": "color_up",
   "label": "上调点颜色",
   "type": "text",
   "required": false,
   "default": "#dc2626",
   "hint": "HEX 颜色，仅影响呈现"
  },
  {
   "id": "color_down",
   "label": "下调点颜色",
   "type": "text",
   "required": false,
   "default": "#2563eb",
   "hint": "HEX 颜色，仅影响呈现"
  },
  {
   "id": "color_ns",
   "label": "非显著点颜色",
   "type": "text",
   "required": false,
   "default": "#94a3b8",
   "hint": "HEX 颜色，仅影响呈现"
  },
  {
   "id": "point_size",
   "label": "点大小",
   "type": "number",
   "required": false,
   "default": 1.8,
   "hint": "仅影响呈现"
  },
  {
   "id": "base_font_size",
   "label": "图表基础字号",
   "type": "number",
   "required": false,
   "default": 12,
   "hint": "仅影响呈现"
  },
  {
   "id": "plot_title",
   "label": "图标题",
   "type": "text",
   "required": false,
   "default": "Volcano Plot",
   "hint": "仅影响呈现"
  },
  {
   "id": "legend_position",
   "label": "图例位置",
   "type": "select",
   "required": false,
   "default": "right",
   "options": [
    "right",
    "left",
    "top",
    "bottom",
    "none"
   ],
   "hint": "仅影响呈现"
  },
  {
   "id": "plot_width",
   "label": "导出宽度（英寸）",
   "type": "number",
   "required": false,
   "default": 7,
   "hint": "仅影响呈现"
  },
  {
   "id": "plot_height",
   "label": "导出高度（英寸）",
   "type": "number",
   "required": false,
   "default": 5,
   "hint": "仅影响呈现"
  },
  {
   "id": "export_dpi",
   "label": "导出 DPI",
   "type": "number",
   "required": false,
   "default": 300,
   "hint": "仅影响呈现"
  },
  {
   "id": "point_alpha",
   "label": "点透明度",
   "type": "number",
   "required": false,
   "default": 0.6,
   "hint": "0.05–1"
  },
  {
   "id": "label_size",
   "label": "基因标签字号",
   "type": "number",
   "required": false,
   "default": 3,
   "hint": "1–8"
  }
 ],
 "outputs": [
  {
   "id": "volcano",
   "filename": "volcano.png",
   "type": "plot",
   "label": "火山图"
  },
  {
   "id": "volcano_svg",
   "filename": "volcano.svg",
   "type": "plot",
   "label": "火山图 SVG"
  },
  {
   "id": "classified_table",
   "filename": "classified_table.csv",
   "type": "table",
   "label": "分类结果表"
  }
 ],
 "resultStudio": {
  "contractVersion": 1,
  "descriptorVersion": 1,
  "semanticType": "differential_expression_volcano",
  "entity": {
   "type": "classified_gene",
   "idField": "gene",
   "fields": {
    "gene": "string",
    "log2FoldChange": "number",
    "significance": "number",
    "significance_column": "string",
    "pvalue": "number",
    "padj": "number",
    "sig": "string"
   }
  },
  "source": {
   "strategy": "execution_snapshot_per_artifact",
   "entryPoint": "scripts/volcano-plot.R"
  },
  "independentScriptPathTemplate": "analysis/scripts/{artifactFamilyId}/{revisionId}/{artifactId}.R",
  "inputBindings": [
   {
    "inputId": "deg_table",
    "required": true,
    "acceptsArtifactTypes": [
     "table"
    ],
    "semanticRole": "differential_expression_table"
   }
  ],
  "parameters": {
   "lfc_col": {
    "type": "text",
    "default": null
   },
   "gene_col": {
    "type": "text",
    "default": "gene"
   },
   "pval_col": {
    "type": "text",
    "default": "padj"
   },
   "fc_threshold": {
    "type": "number",
    "default": 1,
    "minimum": 0
   },
   "pval_threshold": {
    "type": "number",
    "default": 1.3,
    "minimum": 0
   },
   "top_n": {
    "type": "number",
    "default": 10,
    "minimum": 0
   },
   "label_genes": {
    "type": "text",
    "default": ""
   },
   "color_up": {
    "type": "text",
    "default": "#dc2626"
   },
   "color_down": {
    "type": "text",
    "default": "#2563eb"
   },
   "color_ns": {
    "type": "text",
    "default": "#94a3b8"
   },
   "point_size": {
    "type": "number",
    "default": 1.8,
    "minimum": 0.2,
    "maximum": 6
   },
   "base_font_size": {
    "type": "number",
    "default": 12,
    "minimum": 6,
    "maximum": 24
   },
   "plot_title": {
    "type": "text",
    "default": "Volcano Plot"
   },
   "legend_position": {
    "type": "select",
    "default": "right",
    "options": [
     "right",
     "left",
     "top",
     "bottom",
     "none"
    ]
   },
   "plot_width": {
    "type": "number",
    "default": 7,
    "minimum": 3,
    "maximum": 20
   },
   "plot_height": {
    "type": "number",
    "default": 5,
    "minimum": 3,
    "maximum": 20
   },
   "export_dpi": {
    "type": "number",
    "default": 300,
    "minimum": 72,
    "maximum": 1200
   },
   "point_alpha": {
    "type": "number",
    "default": 0.6,
    "minimum": 0.05,
    "maximum": 1
   },
   "label_size": {
    "type": "number",
    "default": 3,
    "minimum": 1,
    "maximum": 8
   }
  },
  "previewResourceModel": {
   "baseMemoryBytes": 268435456,
   "inputMemoryMultiplier": 4,
   "outputDiskMultiplier": 2,
   "raster": {
    "widthParameter": "plot_width",
    "heightParameter": "plot_height",
    "dpiParameter": "export_dpi",
    "bytesPerPixel": 4,
    "workingSetMultiplier": 3
   }
  },
  "parameterImpacts": {
   "lfc_col": "data",
   "gene_col": "data",
   "pval_col": "scientific",
   "fc_threshold": "scientific",
   "pval_threshold": "scientific",
   "top_n": "data",
   "label_genes": "presentation",
   "color_up": "presentation",
   "color_down": "presentation",
   "color_ns": "presentation",
   "point_size": "presentation",
   "base_font_size": "presentation",
   "plot_title": "presentation",
   "legend_position": "presentation",
   "plot_width": "presentation",
   "plot_height": "presentation",
   "export_dpi": "presentation",
   "point_alpha": "presentation",
   "label_size": "presentation"
  },
  "actions": [
   "select_genes",
   "classify_rows",
   "recompute"
  ],
  "artifacts": [
   {
   "id": "volcano",
   "type": "plot",
   "filename": "volcano.png",
   "interaction": "interactive"
  },
   {
    "id": "volcano_svg",
    "type": "plot",
    "filename": "volcano.svg",
    "interaction": "noninteractive"
   },
   {
    "id": "classified_table",
    "type": "table",
    "filename": "classified_table.csv",
    "interaction": "interactive"
   }
  ],
  "interactionMappings": [
   {
    "artifactId": "classified_table",
    "mode": "table",
    "entityType": "gene",
    "idField": "gene"
   },
   {
   "artifactId": "volcano",
    "mode": "scatter",
    "dataArtifactId": "classified_table",
    "entityType": "gene",
    "idField": "gene",
    "xField": "log2FoldChange",
    "yField": "significance",
    "yTransform": "neg_log10",
   "legendField": "sig"
   }
  ],
  "validator": {
   "id": "volcano_result_truth_v1",
   "checks": [
    "artifact_truth_valid",
    "script_sha256",
    "input_sha256",
    "output_sha256",
    "finite_statistics"
   ]
  },
  "goldenFixture": {
   "path": "golden-revisions/result-studio-v1.json"
  },
  "upgradePolicy": {
   "sameMajor": "compatible_if_contract_digests_match",
   "contractDrift": "migration_required",
   "missingMigration": "read_only_legacy"
  }
 },
 "failureModes": [
  {
   "code": "missing_required_file_inputs",
   "title": "缺少必需输入文件",
   "description": "火山图至少需要差异分析结果表；没有该表就无法继续。",
   "recoverable": true,
   "suggestedFix": "让 Harness 自动从项目中选择差异结果表，或手动补充输入文件。",
   "detect": "missing required file inputs|missing input file|please provide file"
  },
  {
   "code": "missing_required_columns",
   "title": "缺少必需列",
   "description": "输入 CSV 必须包含 gene、log2FC 和调用方选择的显著性列；默认显著性列为 padj。",
   "recoverable": true,
   "suggestedFix": "探测表头并尝试把 symbol/gene_name 映射为 gene，把 logFC/avg_log2FC 映射为 log2FC；缺少 padj 时必须显式选择其他统计量。",
   "detect": "missing required columns|LFC 列|log2FoldChange|log2FC|实际列名"
  },
  {
   "code": "invalid_numeric_values",
   "title": "数值列不可解析",
   "description": "log2FC 或所选显著性列存在非数字、空值、无限值或超出 0 到 1，导致绘图失败。",
   "recoverable": true,
   "suggestedFix": "过滤无效行并提示用户确认阈值；如果有效行过少则中断并请求用户更换输入。",
   "detect": "invalid numeric values|non-numeric|nan|inf"
  },
  {
   "code": "empty_significant_set",
   "title": "没有满足阈值的显著基因",
   "description": "阈值过严或数据本身没有显著差异，图可生成但标注/分类结果可能为空。",
   "recoverable": true,
   "suggestedFix": "降低 fc_threshold 或 pval_threshold，并在报告中说明阈值变化。",
   "detect": "empty significant set|no significant genes|no rows meet threshold"
  }
 ],
 "estimatedMinutes": 2
}
