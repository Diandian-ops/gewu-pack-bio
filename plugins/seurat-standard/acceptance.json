{
  "schemaVersion": 1,
  "pluginId": "seurat-standard",
  "pluginVersion": "1.0.0",
  "platforms": ["macos-arm64", "windows-x64"],
  "fixtures": [
    {
      "id": "valid",
      "description": "PBMC 3k-like RDS fixture (270 cells × 100 genes × 3 simulated clusters), default Seurat params — expected all 8 outputs produced",
      "inputs": {
        "matrix_file": "demo-data/pbmc_3k_mini.rds",
        "species": "human",
        "min_features": 50,
        "max_features": 5000,
        "max_mt": 20,
        "nfeatures": 100,
        "dims": 10,
        "resolution": 0.5,
        "top_n_markers": 10
      },
      "expectedStatus": "valid",
      "expectedOutputs": [
        "seurat_obj.rds",
        "markers_table.csv",
        "qc_metrics.csv",
        "umap_clusters.png",
        "umap_coords.csv",
        "hvg_plot.png",
        "report.html",
        "manifest.json"
      ]
    },
    {
      "id": "missing-inputs",
      "description": "No matrix file in jobDir — preflight fails fast with exit code 3",
      "inputs": {},
      "expectedStatus": "blocked",
      "expectedFailureMode": "missing_required_file_inputs"
    },
    {
      "id": "runtime-not-ready",
      "description": "biof3-r-runtime not provisioned — Seurat loadNamespace fails, exit code 4",
      "inputs": {
        "matrix_file": "demo-data/pbmc_3k_mini.rds"
      },
      "expectedStatus": "blocked",
      "expectedFailureMode": "runtime_not_ready",
      "skipOnSupportedPlatform": true
    },
    {
      "id": "empty-result",
      "description": "Tiny RDS (< 50 obs after QC) — script returns exit code 0 with placeholder PNG + qc_summary, valid status with empty-result note",
      "inputs": {
        "matrix_file": "demo-data/pbmc_3k_mini.rds",
        "min_features": 5000,
        "max_features": 100,
        "max_mt": 0
      },
      "expectedStatus": "valid",
      "expectedFailureMode": "empty_result"
    }
  ],
  "reproducibility": {
    "requireScriptSha256": true,
    "requireParamsHash": true,
    "requireInputSha256": true,
    "requireOutputSha256": true,
    "requireRVersion": true,
    "requirePackageVersions": true,
    "evidenceSource": "runtime-generated artifact-manifest.json + provenance.json"
  }
}