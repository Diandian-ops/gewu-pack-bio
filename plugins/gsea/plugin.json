      "DOSE": ">=4.4.0",
      "org.Hs.eg.db": ">=3.22.0",
      "org.Mm.eg.db": ">=3.22.0",
      "msigdbr": ">=26.1.0",
      "KEGGREST": ">=1.50.0",
      "ggplot2": ">=4.0.0",
      "jsonlite": ">=1.8.0",
      "base64enc": ">=0.1-3"
    }
  },
  "runtime": {
    "r": ">=4.4.0"
  },
  "builtAgainst": {
    "r": "4.5"
